# Postgres connection string. `npm run dev:all` sets this itself for the local database.
DATABASE_URL=postgresql://user:password@localhost:5432/forum
# Random string (32+ chars) used to sign session cookies. Login refuses to work without it.
SESSION_SECRET=
# Discord OAuth app (redirect: PUBLIC_APP_URL/auth/callback).
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
PUBLIC_APP_URL=http://localhost:4321
# Comma-separated Discord user ids that are admins.
ADMIN_DISCORD_IDS=
# Optional: bot token + guild to give moderators their role from Discord roles.
DISCORD_TOKEN=
DISCORD_GUILD_ID=
# Comma-separated Discord role names or ids that count as moderator (default: moderator).
DISCORD_MODERATOR_ROLES=
# The forum is staff-only (moderator/admin roles) until this is exactly 1. Leave it empty until launch.
FORUM_PUBLIC=
# 1 enables /auth/dev fake login (dev server only, never in production builds).
DEV_LOGIN=
