---
import { Image } from "astro:assets";
import logo from "../assets/dmz-title.png";
import curseforgeIcon from "../assets/curseforge.svg?raw";
import modrinthIcon from "../assets/modrinth.svg?raw";
import { t, type Lang } from "../i18n";

const { lang } = Astro.props as { lang: Lang };

// Same links as the website's footer. `svg` entries are our own bundled files, not user content.
const socials = [
  { name: "Discord", href: "https://discord.com/servers/dragonmine-z-1216429657273012415", fa: "fa-discord" },
  { name: "GitHub", href: "https://github.com/DragonMineZ/dragonminez", fa: "fa-github" },
  { name: "X (Twitter)", href: "https://x.com/DragonMineZ", fa: "fa-x-twitter" },
  { name: "YouTube", href: "https://www.youtube.com/@DragonMine-Z", fa: "fa-youtube" },
  { name: "TikTok", href: "https://www.tiktok.com/@dragonminez", fa: "fa-tiktok" },
  { name: "CurseForge", href: "https://www.curseforge.com/minecraft/mc-mods/dragonminez", svg: curseforgeIcon },
  { name: "Modrinth", href: "https://modrinth.com/mod/dragonminez", svg: modrinthIcon },
];
---

<footer class="dark w-full bg-[#1c1b22] text-white py-14 px-6 md:px-8 border-t border-white/5">
  <div class="max-w-4xl mx-auto flex flex-col items-center text-center gap-4">
    <a href="/" class="mb-2 block transition-transform hover:scale-105 active:scale-95">
      <Image src={logo} alt="DragonMineZ" class="h-10 md:h-12 w-auto object-contain" />
    </a>

    <div class="flex flex-col gap-2">
      <p class="text-base font-bold tracking-wide">© {new Date().getFullYear()} DragonMineZ | Fair Use</p>
      <p class="text-sm text-white/70 max-w-xl leading-relaxed">{t(lang, "footer.description")}</p>
    </div>

    <div class="w-2/3 max-w-[400px] h-px bg-white/20 rounded-full mt-2 mb-1"></div>

    <div class="flex flex-wrap justify-center items-center gap-4 sm:gap-6 md:gap-8 mt-1">
      {socials.map((s) => (
        <a
          href={s.href}
          target="_blank"
          rel="noopener noreferrer"
          title={s.name}
          aria-label={s.name}
          class="text-xl sm:text-2xl flex items-center justify-center text-white hover:text-white/80 hover:-translate-y-1 transition-all duration-300"
        >
          {s.svg ? <span class="flex items-center justify-center" set:html={s.svg} /> : <i class={`fa-brands ${s.fa}`} />}
        </a>
      ))}
    </div>

  </div>
</footer>
