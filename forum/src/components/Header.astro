---
import { Image } from "astro:assets";
import logo from "../assets/dmz-title.png";
import { t, type Lang } from "../i18n";
import { isStaff } from "../lib/guard";
import { prisma } from "../lib/prisma";

const { lang, crumbs = [] } = Astro.props as { lang: Lang; crumbs?: { label: string; href: string }[] };
const user = Astro.locals.user;
// One count for the bell badge. Pages that mark notifications read do it before the layout renders.
const unread = user ? await prisma.notification.count({ where: { userId: user.id, readAt: null } }) : 0;
// Staff see how much waits in /mod.
const queue = isStaff(user) && !user?.banned
  ? (await prisma.report.count({ where: { status: "open" } })) + (await prisma.server.count({ where: { status: "pending" } }))
  : 0;
const loginHref = `/auth/login?next=${encodeURIComponent(Astro.url.pathname + Astro.url.search)}`;

const links = [
  { href: "/", key: "nav.forum", external: false },
  { href: "/servers", key: "nav.servers", external: false },
  { href: "https://discord.com/servers/dragonmine-z-1216429657273012415", key: "nav.discord", external: true },
  { href: "https://dragonminez.com/hairsalon", key: "nav.hairsalon", external: true },
  { href: "https://wiki.dragonminez.com", key: "nav.wiki", external: true },
];
const downloads = [
  { href: "https://www.curseforge.com/minecraft/mc-mods/dragonminez", name: "CurseForge" },
  { href: "https://modrinth.com/mod/dragonminez", name: "Modrinth" },
];
const linkClass = "hover:text-foreground transition-colors w-full xl:w-auto text-center py-2 xl:py-0";
---

<header class="fixed top-0 z-50 w-full border-b border-white/10 bg-background/80 backdrop-blur-md">
  <div class="mx-auto flex h-20 w-full items-center justify-between px-6 xl:px-8">
    <div class="flex items-center gap-2 sm:gap-3 shrink-0 z-[61] min-w-0">
      <a href="https://dragonminez.com" aria-label="DragonMineZ">
        <Image src={logo} alt="DragonMineZ" class="h-7 sm:h-10 xl:h-12 w-auto object-contain transition-transform hover:scale-105 active:scale-95" />
      </a>
      <a href="/" class="rounded-full border border-white/15 bg-black/35 px-3 py-1 text-[10px] font-bold uppercase tracking-widest text-white/85 backdrop-blur hover:bg-white/10 transition-colors">
        {t(lang, "nav.forum")}
      </a>
      {crumbs.map((c) => (
        <>
          <span class="hidden sm:inline text-white/30">/</span>
          <a href={c.href} class="hidden sm:inline truncate text-[11px] font-bold uppercase tracking-widest text-white/60 hover:text-white transition-colors">{c.label}</a>
        </>
      ))}
    </div>

    <button
      id="menu-button"
      class="flex xl:hidden items-center justify-center p-2 z-[61] rounded-xl hover:bg-white/10 transition-colors"
      aria-label={t(lang, "nav.menu")}
    >
      <span class="material-symbols-rounded text-3xl">menu</span>
    </button>

    <nav
      id="main-nav"
      class="absolute top-full left-0 w-full bg-surface/95 backdrop-blur-xl xl:static xl:w-auto xl:bg-transparent xl:backdrop-blur-none flex flex-col xl:flex-row items-center p-6 xl:p-0 gap-4 xl:gap-3 whitespace-nowrap font-medium text-muted transition-all duration-300 -translate-y-4 opacity-0 pointer-events-none xl:translate-y-0 xl:opacity-100 xl:pointer-events-auto border-b border-white/10 xl:border-none rounded-b-3xl xl:rounded-none z-[60]"
    >
      <form method="get" action="/search" class="relative w-full xl:w-44" role="search">
        <span class="material-symbols-rounded pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-xl text-muted" aria-hidden="true">search</span>
        <input
          id="forum-search"
          type="search"
          name="q"
          maxlength="80"
          placeholder={t(lang, "nav.search")}
          aria-label={t(lang, "nav.search")}
          class="h-11 w-full rounded-full border border-white/10 bg-white/5 pl-10 pr-10 text-sm text-foreground placeholder:text-muted"
        />
        <kbd class="pointer-events-none absolute right-3 top-1/2 hidden -translate-y-1/2 rounded-md border border-white/15 px-1.5 text-xs font-bold text-white/55 xl:block">/</kbd>
      </form>
      <div class="group relative w-full xl:w-auto">
        <button type="button" class={`${linkClass} flex items-center justify-center gap-1 cursor-pointer`} aria-haspopup="true">
          {t(lang, "nav.download")}<span class="material-symbols-rounded text-xl">expand_more</span>
        </button>
        <div class="flex justify-center gap-4 xl:hidden xl:group-hover:flex xl:group-focus-within:flex xl:absolute xl:right-0 xl:top-full xl:flex-col xl:gap-1 xl:rounded-2xl xl:border xl:border-white/10 xl:bg-surface xl:p-2 xl:shadow-dropdown">
          {downloads.map((d) => (
            <a href={d.href} target="_blank" rel="noopener noreferrer" class="hover:text-foreground transition-colors xl:rounded-xl xl:px-4 xl:py-2 xl:hover:bg-white/5 whitespace-nowrap">{d.name}</a>
          ))}
        </div>
      </div>
      {links.map((l) => (
        <a href={l.href} class={linkClass} {...(l.external && { target: "_blank", rel: "noopener noreferrer" })}>
          {t(lang, l.key)}
        </a>
      ))}
      {user ? (
        <>
          {isStaff(user) && !user.banned && (
            <a href="/mod" class={`${linkClass} flex items-center justify-center gap-1`}>
              {t(lang, "mod.link")}
              {queue > 0 && <span class="rounded-full bg-[#f97316] px-1.5 text-xs font-bold text-white">{queue > 99 ? "99+" : queue}</span>}
            </a>
          )}
          <a href={`/u/${user.id}`} class="flex items-center justify-center gap-2 hover:text-foreground transition-colors w-full xl:w-auto py-2 xl:py-0">
            {user.avatarUrl ? (
              <img src={user.avatarUrl} alt="" width="28" height="28" class="size-7 rounded-full" referrerpolicy="no-referrer" />
            ) : (
              <span class="flex size-7 items-center justify-center rounded-full bg-[#f97316] text-sm font-bold text-white">
                {user.username.charAt(0).toUpperCase()}
              </span>
            )}
            <span class="max-w-40 truncate">{user.username}</span>
          </a>
          <a
            href="/notifications"
            class="relative flex items-center justify-center hover:text-foreground transition-colors w-full xl:w-auto py-2 xl:py-0"
            aria-label={t(lang, "nav.notifications")}
            title={t(lang, "nav.notifications")}
          >
            <span class="material-symbols-rounded">notifications</span>
            {unread > 0 && (
              <span class="ml-1 xl:ml-0 xl:absolute xl:-top-2 xl:-right-2 rounded-full bg-[#f97316] px-1.5 text-xs font-bold text-white">
                {unread > 9 ? "9+" : unread}
              </span>
            )}
          </a>
          <form method="post" action="/auth/logout" class="w-full xl:w-auto">
            <button class="rounded-xl border border-white/10 px-4 py-2 hover:bg-white/10 hover:text-foreground transition-colors w-full xl:w-auto text-center cursor-pointer">
              {t(lang, "nav.logout")}
            </button>
          </form>
        </>
      ) : (
        <a
          href={loginHref}
          class="rounded-xl bg-[#f97316] px-4 py-2 text-white font-semibold hover:brightness-110 transition w-full xl:w-auto text-center"
        >
          {t(lang, "nav.login")}
        </a>
      )}
    </nav>
  </div>
  {user?.banned && (
    <p class="border-t border-red-500/20 bg-red-500/15 px-4 py-1 text-center text-xs text-red-300">{t(lang, "auth.banned")}</p>
  )}
</header>

<script>
  addEventListener("keydown", (e) => {
    const el = document.activeElement;
    if (e.key !== "/" || e.ctrlKey || e.metaKey || e.altKey || (el instanceof HTMLElement && el.matches("input, textarea, select, [contenteditable]"))) return;
    e.preventDefault();
    document.getElementById("forum-search")?.focus();
  });
  const button = document.getElementById("menu-button");
  const nav = document.getElementById("main-nav");
  button?.addEventListener("click", () => {
    const open = !!nav?.classList.contains("opacity-0");
    nav?.classList.toggle("-translate-y-4", !open);
    nav?.classList.toggle("opacity-0", !open);
    nav?.classList.toggle("pointer-events-none", !open);
    nav?.classList.toggle("translate-y-0", open);
    nav?.classList.toggle("opacity-100", open);
    nav?.classList.toggle("pointer-events-auto", open);
    const icon = button.querySelector(".material-symbols-rounded");
    if (icon) icon.textContent = open ? "close" : "menu";
  });
</script>
