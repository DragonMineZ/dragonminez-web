---
// Floating language button, bottom right. No JS: <details> opens the list, each option is a /lang/<code> link.
import { t, LANGS, LANG_NAMES, type Lang } from "../i18n";

const { lang } = Astro.props as { lang: Lang };
---

<details class="group fixed bottom-5 right-5 z-40">
  <summary
    class="flex size-12 cursor-pointer list-none items-center justify-center rounded-full border border-white/10 bg-surface shadow-dropdown hover:bg-white/10 transition-colors [&::-webkit-details-marker]:hidden"
    aria-label={t(lang, "footer.language")}
    title={t(lang, "footer.language")}
  >
    <span class="material-symbols-rounded text-2xl">language</span>
  </summary>
  <nav class="absolute bottom-full right-0 mb-3 flex w-44 flex-col gap-1 rounded-2xl border border-white/10 bg-surface p-2 shadow-dropdown" aria-label={t(lang, "footer.language")}>
    {LANGS.map((code) => (
      <a
        href={`/lang/${code}`}
        hreflang={code}
        class:list={["rounded-xl px-4 py-2 text-sm hover:bg-white/5 transition-colors", code === lang ? "text-[#f97316] font-semibold" : "text-muted hover:text-foreground"]}
      >
        {LANG_NAMES[code]}
      </a>
    ))}
  </nav>
</details>
