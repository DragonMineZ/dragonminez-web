---
import { t, getLang } from "../i18n";

// Textarea with Write / Preview tabs. Works without JS (the tabs stay hidden and the form posts normally).
const { name = "body", value = "", rows = 8, label, required = true } = Astro.props as {
  name?: string;
  value?: string;
  rows?: number;
  label?: string;
  required?: boolean;
};
const lang = getLang(Astro.request);
const tab = "rounded-lg px-3 py-1 text-sm font-medium text-muted hover:text-foreground data-[active]:bg-[#f97316] data-[active]:text-white";
---

<div data-md data-empty={t(lang, "forum.previewEmpty")} data-failed={t(lang, "forum.previewFailed")}>
  {label && <span class="block text-sm text-muted mb-1">{label}</span>}
  <div class="hidden w-fit gap-1 mb-3 rounded-xl bg-background p-1" data-md-tabs>
    <button type="button" class={tab} data-md-tab="write" data-active>{t(lang, "forum.write")}</button>
    <button type="button" class={tab} data-md-tab="preview">{t(lang, "forum.preview")}</button>
  </div>
  <textarea
    name={name}
    rows={rows}
    required={required}
    maxlength="5000"
    class="w-full rounded-xl border border-white/10 bg-background px-4 py-3 text-foreground outline-none transition-colors focus:border-[#f97316] resize-y"
    data-md-input>{value}</textarea>
  <div class="hidden rounded-xl border border-white/10 bg-background px-4 py-3 min-h-24 prose-forum" data-md-out></div>
  <p class="mt-1 text-xs text-muted">{t(lang, "forum.hint")}</p>
</div>

<script>
  // The server renders the preview, so what you see is what gets stored and shown.
  document.querySelectorAll<HTMLElement>("[data-md]").forEach((box) => {
    const input = box.querySelector<HTMLTextAreaElement>("[data-md-input]")!;
    const out = box.querySelector<HTMLElement>("[data-md-out]")!;
    const tabs = box.querySelector<HTMLElement>("[data-md-tabs]")!;
    tabs.classList.remove("hidden");
    tabs.classList.add("flex");
    const buttons = [...tabs.querySelectorAll<HTMLButtonElement>("[data-md-tab]")];
    const show = async (mode: string) => {
      buttons.forEach((b) => b.toggleAttribute("data-active", b.dataset.mdTab === mode));
      const preview = mode === "preview";
      input.classList.toggle("hidden", preview);
      out.classList.toggle("hidden", !preview);
      if (!preview) return;
      if (!input.value.trim()) {
        out.textContent = box.dataset.empty ?? "";
        return;
      }
      try {
        const res = await fetch("/api/preview", { method: "POST", body: input.value });
        out.innerHTML = res.ok ? await res.text() : (box.dataset.failed ?? "");
      } catch {
        out.textContent = box.dataset.failed ?? "";
      }
    };
    buttons.forEach((b) => b.addEventListener("click", () => show(b.dataset.mdTab ?? "write")));
  });
</script>
