---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import LanguageButton from "../components/LanguageButton.astro";
import { getLang, t } from "../i18n";

import "@fontsource-variable/onest";
import "../styles/global.css";

export interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  crumbs?: { label: string; href: string }[]; // shown in the header after the "Forum" chip
  blog?: boolean; // announcement post: no top padding, the banner starts right under the fixed header
}

const lang = getLang(Astro.request);
const siteName = t(lang, "site.name");
const { title, description = t(lang, "site.description"), noindex = false, blog = false, crumbs = [] } = Astro.props;
const fullTitle = title ? `${title} | ${siteName}` : siteName;
const fonts =
  "https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200";
---

<!doctype html>
<html class="dark" lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />

    <script is:inline>
      (() => {
        const shared = document.cookie.match(/(?:^|;\s*)dmz_theme=(light|dark)/);
        const theme = shared ? shared[1] : "dark";
        document.documentElement.classList.toggle("dark", theme !== "light");
      })();
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={fonts} />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" integrity="sha512-Evv84Mr4kqVGRNSgIGL/F/aIDqQb7xQ2vcrdIwxfjThSH8CSR7PBEakCr51Ck+w+/U6swU2Im1vVX0SVk9ABhg==" crossorigin="anonymous" referrerpolicy="no-referrer" />
  </head>
  <body class="bg-background text-foreground selection:bg-foreground/10 min-h-screen flex flex-col">
    <Header lang={lang} crumbs={crumbs} />
    <main class:list={["flex-1 pb-12", !blog && "pt-24"]}>
      <slot />
    </main>
    <Footer lang={lang} />
    <LanguageButton lang={lang} />
  </body>
</html>
