---
import Layout from "../layouts/Layout.astro";
import { getLang, t } from "../i18n";

const lang = getLang(Astro.request);
---

<Layout title={t(lang, "error.500.title")} noindex>
  <div class="container-base text-center py-24">
    <h1 class="text-4xl font-bold mb-3">{t(lang, "error.500.title")}</h1>
    <p class="text-muted mb-8">{t(lang, "error.500.text")}</p>
    <a href="/" class="rounded-xl bg-[#f97316] px-5 py-2.5 text-white font-semibold">{t(lang, "error.home")}</a>
  </div>
</Layout>
