---
import Layout from "../../layouts/Layout.astro";
import { getLang, t } from "../../i18n";
import { prisma } from "../../lib/prisma";
import { discordRole } from "../../lib/roles";
import { appUrl, safeEqual, safeNext, startSession } from "../../lib/session";

const lang = getLang(Astro.request);
const state = Astro.cookies.get("dmz_forum_state")?.value ?? "";
const next = safeNext(Astro.cookies.get("dmz_forum_next")?.value);
Astro.cookies.delete("dmz_forum_state", { path: "/auth" });
Astro.cookies.delete("dmz_forum_next", { path: "/auth" });

// The Discord token lives only inside this function: never stored, never logged.
async function login(): Promise<void> {
  const code = Astro.url.searchParams.get("code");
  const sent = Astro.url.searchParams.get("state") ?? "";
  const clientId = process.env.DISCORD_CLIENT_ID;
  const clientSecret = process.env.DISCORD_CLIENT_SECRET;
  if (!clientId || !clientSecret) throw new Error("Discord login is not configured");
  if (!code || state.length !== 64 || !safeEqual(sent, state)) throw new Error("bad state or missing code");

  const tokenRes = await fetch("https://discord.com/api/oauth2/token", {
    method: "POST",
    headers: { "Content-Type": "application/x-www-form-urlencoded" },
    body: new URLSearchParams({
      grant_type: "authorization_code",
      code,
      redirect_uri: `${appUrl(Astro.url)}/auth/callback`,
      client_id: clientId,
      client_secret: clientSecret,
    }),
    signal: AbortSignal.timeout(10_000),
  });
  if (!tokenRes.ok) throw new Error(`token exchange answered ${tokenRes.status}`);
  const token = (await tokenRes.json()).access_token;
  if (typeof token !== "string" || !token) throw new Error("token exchange returned no access token");

  const meRes = await fetch("https://discord.com/api/users/@me", {
    headers: { Authorization: `Bearer ${token}` },
    signal: AbortSignal.timeout(10_000),
  });
  if (!meRes.ok) throw new Error(`/users/@me answered ${meRes.status}`);
  const me = await meRes.json();
  const discordId = String(me.id ?? "");
  if (!/^\d{5,25}$/.test(discordId)) throw new Error("/users/@me returned no id");

  const username = String(me.global_name || me.username || "user").slice(0, 64);
  const avatarUrl = /^[a-z0-9_]+$/i.test(String(me.avatar ?? ""))
    ? `https://cdn.discordapp.com/avatars/${discordId}/${me.avatar}.png?size=128`
    : null;
  const data = { username, avatarUrl, role: await discordRole(discordId) };
  const user = await prisma.user.upsert({ where: { discordId }, update: data, create: { discordId, ...data } });
  startSession(Astro.cookies, user.id, Astro.url);
}

try {
  await login();
  return Astro.redirect(next);
} catch (err) {
  console.warn("[auth] login failed:", err instanceof Error ? err.message : "unknown error");
  Astro.response.status = 400;
}
---

<Layout title={t(lang, "auth.failed.title")} noindex>
  <div class="container-base text-center py-24">
    <h1 class="text-4xl font-bold mb-3">{t(lang, "auth.failed.title")}</h1>
    <p class="text-muted mb-8">{t(lang, "auth.failed.text")}</p>
    <a href="/auth/login" class="rounded-xl bg-[#f97316] px-5 py-2.5 text-white font-semibold">
      {t(lang, "auth.failed.retry")}
    </a>
  </div>
</Layout>
