---
// Fake login for local development. A production build answers 404: `import.meta.env.DEV` is false there.
import Layout from "../../layouts/Layout.astro";
import { getLang, t } from "../../i18n";
import { prisma } from "../../lib/prisma";
import { safeNext, startSession } from "../../lib/session";

if (!(import.meta.env.DEV && process.env.DEV_LOGIN === "1")) {
  return new Response("Not found", { status: 404 });
}

const lang = getLang(Astro.request);
const roles = ["member", "mod", "admin"];
let next = safeNext(Astro.url.searchParams.get("next"));

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  // The quick buttons log in as the seeded users (dev-member, dev-mod, dev-admin).
  const quick = String(form.get("quick") ?? "");
  const name = (roles.includes(quick) ? quick : String(form.get("name") ?? "")).trim().slice(0, 32);
  const role = roles.includes(quick) ? quick : String(form.get("role") ?? "");
  const slug = name.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-+|-+$/g, "");
  next = safeNext(String(form.get("next") ?? ""));
  if (slug && roles.includes(role)) {
    const user = await prisma.user.upsert({
      where: { discordId: `dev-${slug}` },
      update: { role },
      create: { discordId: `dev-${slug}`, username: name, role },
    });
    startSession(Astro.cookies, user.id, Astro.url);
    return Astro.redirect(next, 303);
  }
}
const field = "mt-1 w-full rounded-xl border border-white/10 bg-background px-3 py-2 text-foreground";
const button = "rounded-xl bg-[#f97316] px-4 py-2 text-white font-semibold hover:brightness-110 transition";
---

<Layout title={t(lang, "auth.dev.title")} noindex>
  <div class="container-base max-w-md">
    <h1 class="text-2xl font-bold mb-4">{t(lang, "auth.dev.title")}</h1>
    <form method="post" class="rounded-2xl border border-white/10 bg-surface p-5 space-y-4">
      <input type="hidden" name="next" value={next} />
      <div class="flex flex-wrap gap-2">
        {roles.map((r) => (
          <button name="quick" value={r} formnovalidate class={button}>{t(lang, `role.${r}`)}</button>
        ))}
      </div>
      <label class="block text-sm text-muted">
        {t(lang, "auth.dev.name")}
        <input name="name" required maxlength="32" class={field} />
      </label>
      <label class="block text-sm text-muted">
        {t(lang, "auth.dev.role")}
        <select name="role" class={field}>
          {roles.map((r) => <option value={r}>{t(lang, `role.${r}`)}</option>)}
        </select>
      </label>
      <button class={button}>{t(lang, "auth.dev.submit")}</button>
    </form>
  </div>
</Layout>
