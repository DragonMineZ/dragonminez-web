---
import Layout from "../layouts/Layout.astro";
import { prisma } from "../lib/prisma";
import { getLang, t, timeAgo } from "../i18n";

const lang = getLang(Astro.request);

const icons: Record<string, string> = {
  announcements: "campaign",
  servers: "dns",
  guides: "menu_book",
  suggestions: "lightbulb",
  "bug-reports": "bug_report",
};

// Threads of servers that are not approved yet stay out of the public lists.
const visible = { OR: [{ server: { is: null } }, { server: { is: { status: "approved" } } }] };

const categories = await prisma.category.findMany({
  orderBy: { position: "asc" },
  include: {
    _count: { select: { threads: { where: visible } } },
    threads: { where: visible, orderBy: { lastPostAt: "desc" }, take: 1, select: { id: true, title: true, lastPostAt: true } },
  },
});
const serverCount = await prisma.server.count({ where: { status: "approved" } });
const newest = await prisma.thread.findMany({
  where: visible,
  orderBy: { createdAt: "desc" },
  take: 5,
  include: { author: { select: { id: true, username: true } } },
});
---

<Layout title={t(lang, "home.title")}>
  <div class="container-base space-y-10">
    <section>
      <h1 class="text-2xl font-bold mb-4">{t(lang, "home.categories")}</h1>
      <div class="rounded-2xl border border-white/10 bg-surface divide-y divide-white/10 overflow-hidden">
        {categories.map((c) => {
          const latest = c.threads[0];
          return (
            <a
              href={c.kind === "servers" ? "/servers" : `/c/${c.slug}`}
              class="flex items-center gap-4 px-5 py-4 hover:bg-white/5 transition-colors"
            >
              <span class="material-symbols-rounded text-3xl text-[#f97316]">{icons[c.slug] ?? "chat"}</span>
              <div class="flex-1 min-w-0">
                <h2 class="font-semibold">{t(lang, `cat.${c.slug}.name`)}</h2>
                <p class="text-sm text-muted">{t(lang, `cat.${c.slug}.desc`)}</p>
              </div>
              <div class="hidden sm:block text-right text-sm text-muted max-w-xs">
                <p>
                  {c.kind === "servers"
                    ? t(lang, serverCount === 1 ? "servers.count1" : "servers.count", { count: serverCount })
                    : t(lang, c._count.threads === 1 ? "home.thread" : "home.threads", { count: c._count.threads })}
                </p>
                <p class="truncate">
                  {latest ? `${latest.title} · ${timeAgo(lang, latest.lastPostAt)}` : t(lang, "home.noThreads")}
                </p>
              </div>
            </a>
          );
        })}
      </div>
    </section>

    <section>
      <h2 class="text-2xl font-bold mb-4">{t(lang, "home.latest")}</h2>
      <ul class="rounded-2xl border border-white/10 bg-surface divide-y divide-white/10 overflow-hidden">
        {newest.map((th) => (
          <li class="flex items-center justify-between gap-4 px-5 py-3 hover:bg-white/5 transition-colors">
            <a href={`/t/${th.id}`} class="font-medium truncate">{th.title}</a>
            <span class="text-sm text-muted shrink-0">
              <a href={`/u/${th.author.id}`} class="hover:text-foreground">{th.author.username}</a> · {timeAgo(lang, th.createdAt)}
            </span>
          </li>
        ))}
        {newest.length === 0 && <li class="px-5 py-4 text-muted">{t(lang, "home.empty")}</li>}
      </ul>
    </section>
  </div>
</Layout>
