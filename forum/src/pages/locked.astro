---
// Holding page while the forum is staff-only (see lib/access.ts). The middleware rewrites every other URL here for non-staff.
import Layout from "../layouts/Layout.astro";
import { getLang, t } from "../i18n";
import { mayEnter } from "../lib/access";

const lang = getLang(Astro.request);
const user = Astro.locals.user;
// Staff have no reason to be here.
if (mayEnter(user)) return Astro.redirect("/");
Astro.response.status = 403;
---

<Layout title={t(lang, "locked.title")} noindex>
  <div class="container-base max-w-xl py-24 text-center space-y-6">
    <span class="mx-auto flex size-16 items-center justify-center rounded-2xl bg-[#f97316] text-white shadow-lg shadow-[#f97316]/30">
      <span class="material-symbols-rounded text-4xl">lock</span>
    </span>
    <h1 class="text-4xl font-bold">{t(lang, "locked.title")}</h1>
    <p class="text-muted">{t(lang, "locked.text")}</p>
    {user ? (
      <>
        <p class="rounded-2xl border border-white/10 bg-surface p-4 text-sm text-muted">{t(lang, "locked.notStaff", { name: user.username })}</p>
        <form method="post" action="/auth/logout">
          <button class="rounded-xl border border-white/10 px-5 py-2.5 font-semibold hover:bg-white/10 transition-colors cursor-pointer">{t(lang, "nav.logout")}</button>
        </form>
      </>
    ) : (
      <a href="/auth/login?next=/" class="inline-block rounded-xl bg-[#f97316] px-6 py-3 font-semibold text-white hover:brightness-110 transition">
        {t(lang, "locked.login")}
      </a>
    )}
  </div>
</Layout>
