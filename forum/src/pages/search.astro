---
import Layout from "../layouts/Layout.astro";
import Pagination from "../components/Pagination.astro";
import { prisma } from "../lib/prisma";
import { getLang, t, timeAgo } from "../i18n";
import { rateLimit } from "../lib/guard";
import { likeEscape, normalizeQuery, PAGE_SIZE } from "../lib/links";
import { excerpt } from "../lib/text";

const lang = getLang(Astro.request);
const user = Astro.locals.user;
const raw = Astro.url.searchParams.get("q") ?? "";
const q = normalizeQuery(raw);

// 20 searches a minute per user, or per IP when logged out.
const ip = Astro.request.headers.get("x-forwarded-for")?.split(",")[0].trim() || "anon";
const limited = q !== null && !rateLimit(`search:${user ? `u${user.id}` : `ip${ip}`}`, 20, 60_000);
if (limited) Astro.response.status = 429;

const match = q ? { contains: likeEscape(q), mode: "insensitive" as const } : null;
const where = {
  // Pending and rejected servers stay out of search for everyone (staff have /mod).
  AND: [
    { OR: [{ title: match ?? "" }, { posts: { some: { body: match ?? "", deletedAt: null } } }] },
    { OR: [{ server: { is: null } }, { server: { is: { status: "approved" } } }] },
  ],
};
// Note: substring scan (ILIKE '%q%' on titles and post bodies) is a sequential scan.
// Ceiling: fine for thousands of posts; switch to Postgres full-text search (tsvector + GIN) when it gets slow.
const searching = q !== null && !limited;
const total = searching ? await prisma.thread.count({ where }) : 0;
const pages = Math.max(1, Math.ceil(total / PAGE_SIZE));
const page = Math.min(Math.max(1, Number(Astro.url.searchParams.get("page")) || 1), pages);
const found = searching
  ? await prisma.thread.findMany({
      where,
      orderBy: { lastPostAt: "desc" },
      skip: (page - 1) * PAGE_SIZE,
      take: PAGE_SIZE,
      include: {
        category: { select: { slug: true } },
        author: { select: { id: true, username: true } },
        posts: { where: { deletedAt: null, body: match! }, orderBy: { id: "asc" }, take: 1, select: { body: true } },
      },
    })
  : [];
// Title-only matches show the opening post instead.
const results = await Promise.all(
  found.map(async (th) => {
    const post = th.posts[0] ?? (await prisma.post.findFirst({ where: { threadId: th.id, deletedAt: null }, orderBy: { id: "asc" }, select: { body: true } }));
    return { th, text: post ? excerpt(post.body, 200) : "" };
  }),
);
---

<Layout title={t(lang, "search.title")} noindex>
  <div class="container-base max-w-4xl space-y-4">
    <h1 class="text-2xl font-bold">{t(lang, "search.title")}</h1>
    <form method="get" action="/search" class="flex gap-3">
      <input name="q" value={raw.slice(0, 80)} maxlength="80" aria-label={t(lang, "nav.search")} class="min-w-0 flex-1 rounded-xl border border-white/10 bg-background px-3 py-2 text-foreground" />
      <button class="rounded-xl bg-[#f97316] px-4 py-2 text-white font-semibold hover:brightness-110 transition">{t(lang, "search.go")}</button>
    </form>

    {limited ? (
      <p class="rounded-xl border border-error/40 bg-error-glass px-4 py-2 text-sm text-error" role="alert">{t(lang, "search.rate")}</p>
    ) : q === null ? (
      <p class="text-muted">{t(lang, "search.hint")}</p>
    ) : results.length === 0 ? (
      <p class="rounded-2xl border border-white/10 bg-surface p-5 text-muted">{t(lang, "search.empty", { q })}</p>
    ) : (
      <ul class="rounded-2xl border border-white/10 bg-surface divide-y divide-white/10 overflow-hidden">
        {results.map(({ th, text }) => (
          <li class="px-5 py-3 space-y-1">
            <a href={`/t/${th.id}`} class="font-semibold hover:underline break-words">{th.title}</a>
            <p class="text-xs text-muted">
              {t(lang, `cat.${th.category.slug}.name`)} · {t(lang, "forum.by")}
              <a href={`/u/${th.author.id}`} class="hover:text-foreground">{th.author.username}</a> · {timeAgo(lang, th.lastPostAt)}
            </p>
            {text && <p class="text-sm text-muted break-words">{text}</p>}
          </li>
        ))}
      </ul>
    )}
    <Pagination page={page} pages={pages} />
  </div>
</Layout>
