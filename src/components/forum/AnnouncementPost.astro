---
// The blog look of an announcement: banner over its own blurred copy, then, separate from it, one wide box (same width as
// the banner) with date and author, title, subtitle, text and the second image. `html` is the output of renderMarkdown,
// nothing else. Used by the thread page and the preview window.
const { title, subtitle, cover, image, html, date, author } = Astro.props as {
  title: string;
  subtitle?: string | null;
  cover?: string | null;
  image?: string | null;
  html: string;
  date: string;
  author: string;
};
import { getLang, t } from "@/lib/forum/i18n/index.ts";
const lang = getLang(Astro.request);
---

{cover && (
  <section class="relative isolate pt-32">
    <div class="absolute inset-x-0 top-0 bottom-[30%] -z-10 overflow-hidden">
      <img src={cover} alt="" class="size-full scale-110 object-cover opacity-70 blur-md" referrerpolicy="no-referrer" />
      <div class="absolute inset-0 bg-gradient-to-b from-background/40 via-transparent to-background"></div>
    </div>
    <div class="container-base max-w-6xl pt-6">
      <img src={cover} alt="" class="w-full aspect-video rounded-3xl object-cover shadow-hero" referrerpolicy="no-referrer" />
    </div>
  </section>
)}
<div class:list={["container-base max-w-6xl", cover ? "mt-6" : "pt-40"]}>
  <article class="rounded-3xl border border-white/10 bg-surface px-6 py-10 sm:px-16 sm:py-14 shadow-glass">
    <p class="text-center text-xs uppercase tracking-wide text-muted">
      {date} · {t(lang, "news.by", { name: author })}
    </p>
    <h1 class="mt-3 text-center text-4xl sm:text-6xl font-bold leading-tight break-words">{title}</h1>
    {subtitle && <p class="mx-auto mt-5 max-w-3xl text-center text-lg text-foreground/90">{subtitle}</p>}
    <div class="prose-forum mx-auto mt-10 max-w-3xl text-[17px]" set:html={html} />
    {image && (
      <img src={image} alt="" loading="lazy" class="mx-auto mt-10 w-full max-w-3xl rounded-2xl object-cover" referrerpolicy="no-referrer" />
    )}
  </article>
</div>
