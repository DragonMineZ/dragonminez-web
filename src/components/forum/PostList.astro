---
// Posts of a thread (20 per page), pagination and the reply form. Reused by the server detail page.
// Props: thread = { id, locked }, page = 1-based page number, skipFirst = hide the opening post (the server page shows it
// as its description). Forms post to /forum/* and come back to this URL.
import { prisma } from "@/lib/prisma.ts";
import { getLang, t, timeAgo } from "@/lib/forum/i18n/index.ts";
import { isStaff } from "@/lib/forum/guard.ts";
import { renderMarkdown } from "@/lib/forum/text.ts";
import Pagination from "@/components/forum/Pagination.astro";
import MarkdownField from "@/components/forum/MarkdownField.astro";
import RoleChips from "@/components/forum/RoleChips.astro";
import { chips, nameColor } from "@/lib/forum/communityRoles.ts";

const PAGE_SIZE = 20;
const EDIT_WINDOW_MS = 30 * 60 * 1000;

const { thread, page: wanted, skipFirst = false } = Astro.props as {
  thread: { id: number; locked: boolean };
  page: number;
  skipFirst?: boolean;
};
const lang = getLang(Astro.request);
const user = Astro.locals.user;
const staff = isStaff(user);

const first = await prisma.post.findFirst({ where: { threadId: thread.id }, orderBy: { id: "asc" }, select: { id: true } });
const where = { threadId: thread.id, ...(skipFirst && first && { id: { not: first.id } }) };
const total = await prisma.post.count({ where });
const pages = Math.max(1, Math.ceil(total / PAGE_SIZE));
const page = Math.min(Math.max(1, wanted), pages);
const posts = await prisma.post.findMany({
  where,
  orderBy: { id: "asc" },
  skip: (page - 1) * PAGE_SIZE,
  take: PAGE_SIZE,
  include: {
    author: { select: { id: true, username: true, avatarUrl: true, role: true, roles: { select: { role: { select: { id: true, name: true, color: true } } } } } },
    _count: { select: { likes: true } },
    likes: { where: { userId: user?.id ?? 0 }, select: { userId: true } },
  },
});

const here = new URL(Astro.url);
for (const k of ["err", "msg", "edit"]) here.searchParams.delete(k);
const back = here.pathname + here.search;
const editId = Number(Astro.url.searchParams.get("edit")) || 0;
const flash = (kind: "err" | "msg") => {
  const v = Astro.url.searchParams.get(kind) ?? "";
  const key = `forum.${kind}.${v}`;
  return /^[a-z]{1,12}$/.test(v) && t(lang, key) !== key ? t(lang, key) : "";
};
const err = flash("err");
const msg = flash("msg");
const editHref = (id: number) => {
  const u = new URL(here);
  u.searchParams.set("edit", String(id));
  return `${u.pathname}${u.search}#post-${id}`;
};

const button = "rounded-xl bg-[#f97316] px-4 py-2 text-white font-semibold hover:brightness-110 transition";
const small = "text-sm text-muted hover:text-foreground transition-colors";
const canEdit = (p: { authorId: number; deletedAt: Date | null; createdAt: Date }) =>
  user?.id === p.authorId && !user.banned && !p.deletedAt && Date.now() - p.createdAt.getTime() <= EDIT_WINDOW_MS;
const canReply = user && !user.banned && (!thread.locked || staff);
---

<div class="space-y-4">
  {err && <p class="rounded-xl border border-error/40 bg-error-glass px-4 py-2 text-sm text-error" role="alert">{err}</p>}
  {msg && <p class="rounded-xl border border-white/10 bg-surface px-4 py-2 text-sm">{msg}</p>}

  {posts.map((p) => {
    const mine = user?.id === p.authorId;
    const editable = canEdit(p);
    const liked = p.likes.length > 0;
    return (
      <article id={`post-${p.id}`} class="rounded-2xl border border-white/10 bg-surface p-5 scroll-mt-24">
        <header class="flex items-center gap-3 mb-3">
          {p.author.avatarUrl ? (
            <img src={p.author.avatarUrl} alt="" width="36" height="36" class="size-9 rounded-full" referrerpolicy="no-referrer" />
          ) : (
            <span class="flex size-9 items-center justify-center rounded-full bg-[#f97316] font-bold text-white">
              {p.author.username.charAt(0).toUpperCase()}
            </span>
          )}
          <div class="min-w-0">
            <a href={`/forum/u/${p.author.id}`} class="font-semibold hover:underline" style={nameColor(chips(p.author.roles)) ? `color: ${nameColor(chips(p.author.roles))}` : undefined}>{p.author.username}</a>
            {p.author.role !== "member" && (
              <span class="ml-2 rounded-md bg-[#f97316]/15 px-2 py-0.5 text-xs font-semibold text-[#f97316]">{t(lang, `role.${p.author.role}`)}</span>
            )}
            <RoleChips roles={chips(p.author.roles)} />
            <p class="text-xs text-muted">
              <time datetime={p.createdAt.toISOString()} title={p.createdAt.toISOString()}>{timeAgo(lang, p.createdAt)}</time>
              {p.editedAt && !p.deletedAt && <span> · {t(lang, "forum.edited")}</span>}
            </p>
          </div>
        </header>

        {p.deletedAt ? (
          <p class="text-sm italic text-muted">{t(lang, "forum.deleted")}</p>
        ) : editId === p.id && editable ? (
          <form method="post" action="/forum/act/edit" class="space-y-3">
            <input type="hidden" name="postId" value={p.id} />
            <input type="hidden" name="back" value={back} />
            <MarkdownField value={p.body} rows={6} />
            <div class="flex gap-3">
              <button class={button}>{t(lang, "forum.save")}</button>
              <a href={`${back}#post-${p.id}`} class={`${small} self-center`}>{t(lang, "forum.cancel")}</a>
            </div>
          </form>
        ) : (
          <div class="prose-forum" set:html={renderMarkdown(p.body)} />
        )}

        {!p.deletedAt && (
          <footer class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2">
            {user && !user.banned && !mine ? (
              <form method="post" action="/forum/act/like">
                <input type="hidden" name="postId" value={p.id} />
                <input type="hidden" name="back" value={back} />
                <button class={`${small} flex items-center gap-1`} aria-pressed={liked} title={t(lang, liked ? "forum.unlike" : "forum.like")}>
                  <span class="material-symbols-rounded text-lg" style={liked ? "font-variation-settings: 'FILL' 1; color: #f97316" : ""}>favorite</span>
                  {p._count.likes}
                </button>
              </form>
            ) : (
              <span class="flex items-center gap-1 text-sm text-muted">
                <span class="material-symbols-rounded text-lg">favorite</span>{p._count.likes}
              </span>
            )}
            {editable && editId !== p.id && <a href={editHref(p.id)} class={small}>{t(lang, "forum.edit")}</a>}
            {user && !user.banned && !mine && (
              <details>
                <summary class={`${small} cursor-pointer list-none`}>{t(lang, "forum.report")}</summary>
                <form method="post" action="/forum/act/report" class="mt-2 flex flex-wrap gap-2">
                  <input type="hidden" name="postId" value={p.id} />
                  <input type="hidden" name="back" value={back} />
                  <input name="reason" required minlength="5" maxlength="300" placeholder={t(lang, "forum.reportReason")} aria-label={t(lang, "forum.reportReason")} class="min-w-64 flex-1 rounded-xl border border-white/10 bg-background px-3 py-1.5 text-sm" />
                  <button class="rounded-xl border border-white/10 px-3 py-1.5 text-sm hover:bg-white/5">{t(lang, "forum.reportSend")}</button>
                </form>
              </details>
            )}
            {staff && p.id !== first?.id && (
              <form method="post" action="/forum/act/delete-post" onsubmit={`return confirm(${JSON.stringify(t(lang, "forum.deletePost"))})`}>
                <input type="hidden" name="postId" value={p.id} />
                <input type="hidden" name="back" value={back} />
                <button class="text-sm text-error hover:underline">{t(lang, "forum.delete")}</button>
              </form>
            )}
          </footer>
        )}
      </article>
    );
  })}

  <Pagination page={page} pages={pages} />

  <section id="reply" class="scroll-mt-24 rounded-2xl border border-white/10 bg-surface p-5">
    <h2 class="text-lg font-bold mb-3">{t(lang, "forum.replyTitle")}</h2>
    {!user ? (
      <a href={`/forum/login?next=${encodeURIComponent(back)}`} class={button + " inline-block"}>{t(lang, "forum.loginToReply")}</a>
    ) : user.banned ? (
      <p class="text-muted">{t(lang, "auth.banned")}</p>
    ) : !canReply ? (
      <p class="text-muted">{t(lang, "forum.lockedNote")}</p>
    ) : (
      <form method="post" action="/forum/act/reply" class="space-y-3" data-reply={thread.id}>
        <input type="hidden" name="threadId" value={thread.id} />
        <input type="hidden" name="back" value={back} />
        <MarkdownField rows={5} />
        <button class={button}>{t(lang, "forum.reply")}</button>
      </form>
    )}
  </section>
</div>

<script>
  // Keep the reply draft per thread so a refused reply (rate limit) doesn't lose the text.
  const form = document.querySelector<HTMLFormElement>("[data-reply]");
  const box = form?.querySelector("textarea");
  if (form && box) {
    const key = `dmz-draft-${form.dataset.reply}`;
    try {
      if (new URL(location.href).searchParams.has("err")) box.value ||= sessionStorage.getItem(key) ?? "";
      else sessionStorage.removeItem(key);
      box.addEventListener("input", () => sessionStorage.setItem(key, box.value));
    } catch {
      // storage unavailable: no draft
    }
  }
</script>
