---
// Community role pills (name in the role's color), like Discord's. Props: roles = RoleChip[] from lib/communityRoles.
import { chipStyle, type RoleChip } from "@/lib/forum/communityRoles.ts";

const { roles } = Astro.props as { roles: RoleChip[] };
---

{roles.map((r) => (
  <span class="ml-1.5 inline-flex items-center gap-1 rounded-md px-2 py-0.5 text-xs font-semibold" style={chipStyle(r.color)}>
    <span class="size-2 rounded-full" style={`background-color: ${r.color}`}></span>{r.name}
  </span>
))}
