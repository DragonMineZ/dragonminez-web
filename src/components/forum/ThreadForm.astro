---
// The compose form for new threads and for editing an announcement. Posts to the current URL; the preview button (announcements)
// posts the same fields to `previewAction` in a new window. Announcements get the numbered image fields and a live
// map of the post: focusing a field lights up its part of the map (CSS :has, no JS).
import MarkdownField from "@/components/forum/MarkdownField.astro";
import { getLang, t } from "@/lib/forum/i18n/index.ts";

const { heading, sub, icon, blog = false, bug = false, values, error = "", submit, cancel, previewAction } = Astro.props as {
  heading: string;
  sub: string;
  icon: string;
  blog?: boolean;
  bug?: boolean;
  values: { title: string; body: string; subtitle: string; cover: string; image: string; version?: string; env?: string; log?: string; steps?: string };
  error?: string;
  submit: string;
  cancel: string;
  previewAction?: string;
};
const lang = getLang(Astro.request);

const card = "block rounded-2xl border border-white/10 bg-surface p-5 transition-all focus-within:border-[#f97316]/60 focus-within:shadow-[0_0_0_4px_rgba(249,115,22,0.10)]";
const input = "w-full rounded-xl border border-white/10 bg-background px-4 py-3 text-foreground placeholder:text-muted/60 outline-none transition-colors focus:border-[#f97316]";
const hint = "mt-2 text-xs text-muted";
const badge = "inline-flex size-6 shrink-0 items-center justify-center rounded-full bg-[#f97316] text-xs font-bold text-white";
const head = "mb-3 flex items-center gap-2 text-sm font-semibold";
const icon2 = "material-symbols-rounded text-xl text-[#f97316]";
---

<form method="post" id="compose" class="grid items-start gap-6 lg:grid-cols-[minmax(0,1fr)_320px]">
  <div class="space-y-5 min-w-0">
    <header class="relative overflow-hidden rounded-3xl border border-white/10 bg-gradient-to-br from-[#f97316]/20 via-surface to-surface p-6 sm:p-8">
      <div class="pointer-events-none absolute -right-12 -top-12 size-52 rounded-full bg-[#f97316]/25 blur-3xl"></div>
      <div class="relative flex items-center gap-4">
        <span class="flex size-14 shrink-0 items-center justify-center rounded-2xl bg-[#f97316] text-white shadow-lg shadow-[#f97316]/30">
          <span class="material-symbols-rounded text-3xl">{icon}</span>
        </span>
        <div class="min-w-0">
          <h1 class="text-2xl sm:text-3xl font-bold">{heading}</h1>
          <p class="text-muted">{sub}</p>
        </div>
      </div>
    </header>

    {error && <p class="rounded-xl border border-error/40 bg-error-glass px-4 py-3 text-sm text-error" role="alert">{error}</p>}

    {blog && (
      <label class={card} data-zone="cover">
        <span class={head}><span class={badge}>1</span><span class={icon2}>panorama</span>{t(lang, "compose.cover")}<span class="font-normal text-muted">· {t(lang, "compose.optional")}</span></span>
        <input name="cover" type="url" maxlength="500" placeholder="https://" value={values.cover} class={input} data-thumb="cover-thumb" />
        <img id="cover-thumb" alt="" class="mt-3 hidden aspect-video w-full rounded-xl object-cover" referrerpolicy="no-referrer" />
        <p class={hint}>{t(lang, "compose.cover.hint")}</p>
      </label>
    )}

    <label class={card} data-zone="title">
      <span class={head}><span class={icon2}>title</span>{t(lang, "forum.field.title")}<span class="ml-auto font-normal text-muted" data-count-for="title">0/120</span></span>
      <input name="title" required minlength="5" maxlength="120" value={values.title} placeholder={t(lang, "compose.title.placeholder")} class={`${input} text-xl font-semibold`} data-count="title" />
    </label>

    {bug && (
      <div class="grid gap-5 sm:grid-cols-2">
        <label class={card}>
          <span class={head}><span class={icon2}>deployed_code</span>{t(lang, "bug.version")}</span>
          <input name="version" required maxlength="40" value={values.version ?? ""} placeholder="2.2.0" class={input} />
        </label>
        <label class={card}>
          <span class={head}><span class={icon2}>sports_esports</span>{t(lang, "bug.env")}</span>
          <input name="env" required maxlength="80" value={values.env ?? ""} placeholder={t(lang, "bug.env.placeholder")} class={input} />
        </label>
      </div>
    )}

    {blog && (
      <label class={card} data-zone="subtitle">
        <span class={head}><span class={badge}>2</span><span class={icon2}>short_text</span>{t(lang, "compose.subtitle")}<span class="font-normal text-muted">· {t(lang, "compose.optional")}</span><span class="ml-auto font-normal text-muted" data-count-for="subtitle">0/200</span></span>
        <input name="subtitle" maxlength="200" value={values.subtitle} class={input} data-count="subtitle" />
        <p class={hint}>{t(lang, "compose.subtitle.hint")}</p>
      </label>
    )}

    <div class={card} data-zone="body">
      <span class={head}><span class={icon2}>edit_note</span>{t(lang, bug ? "bug.what" : "forum.field.body")}</span>
      <MarkdownField value={values.body} rows={blog ? 14 : 10} />
    </div>

    {bug && (
      <div class={card}>
        <span class={head}><span class={icon2}>format_list_numbered</span>{t(lang, "bug.steps")}</span>
        <MarkdownField name="steps" value={values.steps ?? ""} rows={5} required={false} />
      </div>
    )}

    {bug && (
      <label class={card}>
        <span class={head}><span class={icon2}>description</span>{t(lang, "bug.log")}<span class="font-normal text-muted">· {t(lang, "compose.optional")}</span></span>
        <input name="log" type="url" maxlength="500" placeholder="https://" value={values.log ?? ""} class={input} />
        <p class={hint}>{t(lang, "bug.log.hint")}</p>
      </label>
    )}

    {blog && (
      <label class={card} data-zone="image">
        <span class={head}><span class={badge}>3</span><span class={icon2}>image</span>{t(lang, "compose.image")}<span class="font-normal text-muted">· {t(lang, "compose.optional")}</span></span>
        <input name="image" type="url" maxlength="500" placeholder="https://" value={values.image} class={input} data-thumb="image-thumb" />
        <img id="image-thumb" alt="" class="mt-3 hidden w-full rounded-xl object-cover" referrerpolicy="no-referrer" />
        <p class={hint}>{t(lang, "compose.image.hint")}</p>
      </label>
    )}

    <div class="flex flex-wrap items-center gap-3">
      <button class="inline-flex items-center gap-2 rounded-xl bg-[#f97316] px-6 py-3 font-semibold text-white shadow-lg shadow-[#f97316]/20 transition hover:brightness-110 active:scale-95">
        <span class="material-symbols-rounded text-xl">send</span>{submit}
      </button>
      {blog && previewAction && (
        <button type="submit" formaction={previewAction} formtarget="_blank" formnovalidate class="inline-flex items-center gap-2 rounded-xl border border-white/15 px-5 py-3 font-medium transition hover:bg-white/10">
          <span class="material-symbols-rounded text-xl">open_in_new</span>{t(lang, "compose.preview")}
        </button>
      )}
      <a href={cancel} class="rounded-xl px-4 py-3 text-muted transition-colors hover:text-foreground">{t(lang, "forum.cancel")}</a>
    </div>
  </div>

  <aside class="space-y-4 lg:sticky lg:top-28">
    {blog ? (
      <div class="rounded-2xl border border-white/10 bg-surface p-5">
        <h2 class="flex items-center gap-2 text-sm font-semibold"><span class={icon2}>map</span>{t(lang, "compose.map")}</h2>
        <p class="mt-1 text-xs text-muted">{t(lang, "compose.map.hint")}</p>
        <div class="mt-4 space-y-1.5 rounded-xl bg-background p-2">
          <div data-map="cover" class="map-zone flex h-20 items-center justify-center gap-2 rounded-lg bg-gradient-to-br from-[#f97316]/50 to-fuchsia-500/20 text-xs font-bold"><span class={badge}>1</span>{t(lang, "compose.zone.banner")}</div>
          <div class="space-y-2.5 rounded-lg border border-white/10 bg-surface p-3">
            <div class="mx-auto h-1.5 w-1/3 rounded bg-white/15"></div>
            <div data-map="title" class="map-zone rounded-md py-1 text-center text-sm font-bold">{t(lang, "compose.zone.title")}</div>
            <div data-map="subtitle" class="map-zone flex items-center justify-center gap-2 rounded-md py-1 text-center text-xs text-muted"><span class={badge}>2</span>{t(lang, "compose.zone.subtitle")}</div>
            <div data-map="body" class="map-zone space-y-1.5 rounded-md p-1.5">
              <div class="h-1.5 w-full rounded bg-white/15"></div><div class="h-1.5 w-11/12 rounded bg-white/15"></div><div class="h-1.5 w-4/5 rounded bg-white/15"></div>
              <p class="pt-0.5 text-center text-[10px] font-semibold text-muted">{t(lang, "compose.zone.text")}</p>
            </div>
            <div data-map="image" class="map-zone flex h-14 items-center justify-center gap-2 rounded-md bg-sky-500/20 text-xs font-bold"><span class={badge}>3</span>{t(lang, "compose.zone.image")}</div>
          </div>
        </div>
        <ol class="mt-4 space-y-2 text-xs text-muted">
          <li><b class="text-foreground">1 · {t(lang, "compose.zone.banner")}</b>: {t(lang, "compose.cover.hint")}</li>
          <li><b class="text-foreground">2 · {t(lang, "compose.zone.subtitle")}</b>: {t(lang, "compose.subtitle.hint")}</li>
          <li><b class="text-foreground">3 · {t(lang, "compose.zone.image")}</b>: {t(lang, "compose.image.hint")}</li>
        </ol>
      </div>
    ) : (
      <div class="rounded-2xl border border-white/10 bg-surface p-5">
        <h2 class="flex items-center gap-2 text-sm font-semibold"><span class={icon2}>lightbulb</span>{t(lang, bug ? "compose.tips.bug" : "compose.tips")}</h2>
        <ul class="mt-3 space-y-3 text-sm text-muted">
          {(bug ? ["compose.bugtip1", "compose.bugtip2", "compose.bugtip3"] : ["compose.tip1", "compose.tip2", "compose.tip3"]).map((k) => (
            <li class="flex gap-2"><span class="material-symbols-rounded text-base text-[#f97316]">check_circle</span>{t(lang, k)}</li>
          ))}
        </ul>
      </div>
    )}
  </aside>
</form>

<style is:global>
  .map-zone { outline: 2px solid transparent; outline-offset: 2px; transition: outline-color 0.2s, background-color 0.2s; }
  #compose:has([data-zone="cover"]:focus-within) [data-map="cover"],
  #compose:has([data-zone="title"]:focus-within) [data-map="title"],
  #compose:has([data-zone="subtitle"]:focus-within) [data-map="subtitle"],
  #compose:has([data-zone="body"]:focus-within) [data-map="body"],
  #compose:has([data-zone="image"]:focus-within) [data-map="image"] { outline-color: #f97316; background-color: rgba(249, 115, 22, 0.12); }
</style>

<script>
  // Live character counters and a thumbnail under each image link, so you see what you pasted.
  document.querySelectorAll<HTMLInputElement>("[data-count]").forEach((el) => {
    const out = document.querySelector<HTMLElement>(`[data-count-for="${el.dataset.count}"]`);
    const update = () => out && (out.textContent = `${el.value.length}/${el.maxLength}`);
    el.addEventListener("input", update);
    update();
  });
  document.querySelectorAll<HTMLInputElement>("[data-thumb]").forEach((el) => {
    const img = document.getElementById(el.dataset.thumb ?? "") as HTMLImageElement | null;
    if (!img) return;
    const update = () => {
      const ok = /^https:\/\/\S+$/.test(el.value.trim());
      if (ok) img.src = el.value.trim();
      img.classList.toggle("hidden", !ok);
    };
    img.addEventListener("error", () => img.classList.add("hidden"));
    el.addEventListener("input", update);
    update();
  });
</script>
