---
import Layout from "@/layouts/ForumLayout.astro";
import Pagination from "@/components/forum/Pagination.astro";
import { prisma } from "@/lib/prisma.ts";
import { getLang, t, timeAgo } from "@/lib/forum/i18n/index.ts";
import { canStartThread } from "@/lib/forum/guard.ts";
import { STATUSES, STATUS_STYLE } from "@/lib/forum/status.ts";

const PAGE_SIZE = 20;
const lang = getLang(Astro.request);
const user = Astro.locals.user;
const category = await prisma.forumCategory.findUnique({ where: { slug: Astro.params.slug ?? "" } });
if (!category) return Astro.rewrite("/404");
if (category.kind === "servers") return Astro.redirect("/forum/servers");

// Suggestions and bug reports have a status filter; suggestions are also sorted by votes (default) or by date.
const statuses = STATUSES[category.kind] ?? [];
const suggestions = category.kind === "suggestions";
const wanted = Astro.url.searchParams.get("status") ?? "";
const status = statuses.includes(wanted) ? wanted : "";
const sortNew = suggestions && Astro.url.searchParams.get("sort") === "new";
const where = { categoryId: category.id, ...(status && { status }) };

const total = await prisma.thread.count({ where });
const pages = Math.max(1, Math.ceil(total / PAGE_SIZE));
const page = Math.min(Math.max(1, Number(Astro.url.searchParams.get("page")) || 1), pages);
const threads = await prisma.thread.findMany({
  where,
  orderBy: suggestions
    ? [{ pinned: "desc" }, sortNew ? { createdAt: "desc" } : { votes: "desc" }, { lastPostAt: "desc" }]
    : [{ pinned: "desc" }, { lastPostAt: "desc" }],
  skip: (page - 1) * PAGE_SIZE,
  take: PAGE_SIZE,
  include: { author: { select: { id: true, username: true } } },
});
// Logged out users get a login link; banned users and members in staff or admin only categories get no button.
const canStart = !user || (!user.banned && canStartThread(category, user));
const newHref = user ? `/forum/c/${category.slug}/new` : `/forum/login?next=${encodeURIComponent(`/forum/c/${category.slug}/new`)}`;
const href = (params: Record<string, string>) => {
  const q = new URLSearchParams({ ...(sortNew && { sort: "new" }), ...(status && { status }), ...params });
  for (const [k, v] of [...q]) if (!v) q.delete(k);
  return `/forum/c/${category.slug}${q.size ? `?${q}` : ""}`;
};
const chip = "rounded-full border px-3 py-1 text-sm transition-colors";
const chipOn = "border-[#f97316] bg-[#f97316]/15 text-[#f97316]";
const chipOff = "border-white/10 text-muted hover:text-foreground hover:bg-white/5";
---

<Layout title={t(lang, `cat.${category.slug}.name`)}>
  <div class="container-base max-w-4xl space-y-4">
    <nav class="text-sm text-muted">
      <a href="/forum" class="hover:text-foreground">{t(lang, "nav.forum")}</a>
    </nav>
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div>
        <h1 class="text-2xl font-bold">{t(lang, `cat.${category.slug}.name`)}</h1>
        <p class="text-muted">{t(lang, `cat.${category.slug}.desc`)}</p>
      </div>
      {canStart && (
        <a href={newHref} class="rounded-xl bg-[#f97316] px-4 py-2 text-white font-semibold hover:brightness-110 transition">
          {t(lang, "forum.newThread")}
        </a>
      )}
    </div>

    {statuses.length > 0 && (
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div class="flex flex-wrap gap-2" aria-label={t(lang, "status.label")}>
          <a href={href({ status: "", page: "" })} class:list={[chip, status === "" ? chipOn : chipOff]}>{t(lang, "status.all")}</a>
          {statuses.map((s) => (
            <a href={href({ status: s, page: "" })} class:list={[chip, status === s ? chipOn : chipOff]}>{t(lang, `status.${s}`)}</a>
          ))}
        </div>
        {suggestions && (
          <div class="flex gap-2">
            <a href={href({ sort: "", page: "" })} class:list={[chip, !sortNew ? chipOn : chipOff]}>{t(lang, "sort.top")}</a>
            <a href={href({ sort: "new", page: "" })} class:list={[chip, sortNew ? chipOn : chipOff]}>{t(lang, "sort.new")}</a>
          </div>
        )}
      </div>
    )}

    <ul class="rounded-2xl border border-white/10 bg-surface divide-y divide-white/10 overflow-hidden">
      {threads.map((th) => (
        <li
          class:list={["flex items-center gap-4 px-5 py-3 hover:bg-white/5 transition-colors", (th.pinned || th.cover) && "art-row"]}
          style={th.cover ? `--row-art: url("${th.cover.replace(/["\\]/g, encodeURIComponent)}")` : undefined}
        >
          {suggestions && (
            <div class="relative z-10 flex w-14 shrink-0 flex-col items-center rounded-xl border border-white/10 bg-background py-1" title={t(lang, th.votes === 1 ? "forum.vote1" : "forum.votes", { count: th.votes })}>
              <span class="material-symbols-rounded text-xl text-[#f97316]">arrow_drop_up</span>
              <span class="-mt-1 font-bold">{th.votes}</span>
            </div>
          )}
          <div class="flex-1 min-w-0 relative z-10">
            <a href={`/forum/t/${th.id}`} class="flex items-center gap-2 font-semibold">
              {th.pinned && <span class="material-symbols-rounded text-lg text-[#f97316]" title={t(lang, "forum.pinned")}>push_pin</span>}
              {th.locked && <span class="material-symbols-rounded text-lg text-muted" title={t(lang, "forum.locked")}>lock</span>}
              <span class="truncate">{th.title}</span>
              {statuses.length > 0 && (
                <span class={`shrink-0 rounded-md px-2 py-0.5 text-xs font-semibold ${STATUS_STYLE[th.status] ?? STATUS_STYLE.open}`}>{t(lang, `status.${th.status}`)}</span>
              )}
            </a>
            <p class="text-sm text-muted">
              {t(lang, "forum.by")} <a href={`/forum/u/${th.author.id}`} class="hover:text-foreground">{th.author.username}</a>
            </p>
          </div>
          <div class="text-right text-sm text-muted shrink-0 relative z-10">
            <p>{t(lang, th.replyCount === 1 ? "forum.reply1" : "forum.replies", { count: th.replyCount })}</p>
            <p class="hidden sm:block">{t(lang, "forum.lastActivity", { time: timeAgo(lang, th.lastPostAt) })}</p>
          </div>
        </li>
      ))}
      {threads.length === 0 && <li class="px-5 py-4 text-muted">{t(lang, "forum.noThreads")}</li>}
    </ul>
    <Pagination page={page} pages={pages} />
  </div>
</Layout>
