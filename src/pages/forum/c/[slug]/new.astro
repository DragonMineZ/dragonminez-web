---
import Layout from "@/layouts/ForumLayout.astro";
import ThreadForm from "@/components/forum/ThreadForm.astro";
import { prisma } from "@/lib/prisma.ts";
import { getLang, t } from "@/lib/forum/i18n/index.ts";
import { canStartThread, rateLimit, requireUser } from "@/lib/forum/guard.ts";
import { announcementSchema, bugSchema, threadSchema } from "@/lib/forum/schemas.ts";

const lang = getLang(Astro.request);
const category = await prisma.forumCategory.findUnique({ where: { slug: Astro.params.slug ?? "" } });
if (!category) return Astro.rewrite("/404");
// Server threads are created together with their listing, not here.
if (category.kind === "servers") return Astro.redirect("/forum/servers");

const user = requireUser(Astro);
if (user instanceof Response) return user;
const denied = !canStartThread(category, user);
if (denied) Astro.response.status = 403;

let error = "";
const blog = category.slug === "announcements";
const bug = category.kind === "bugs";
let values = { title: "", body: "", subtitle: "", cover: "", image: "", version: "", env: "", log: "", steps: "" };

// A bug report is stored as one markdown post: the facts first, then what happened and the steps.
const bugBody = (d: { version: string; env: string; log?: string; what: string; steps?: string }) =>
  [
    `**${t(lang, "bug.out.version")}:** ${d.version}`,
    `**${t(lang, "bug.out.env")}:** ${d.env}`,
    d.log && `**${t(lang, "bug.out.log")}:** ${d.log}`,
    `### ${t(lang, "bug.out.what")}
${d.what}`,
    d.steps && `### ${t(lang, "bug.out.steps")}
${d.steps}`,
  ]
    .filter(Boolean)
    .join(`

`);

if (Astro.request.method === "POST") {
  if (denied) return new Response("Forbidden", { status: 403 });
  const form = await Astro.request.formData();
  for (const k of Object.keys(values)) values[k as keyof typeof values] = String(form.get(k) ?? "");
  const parsed = bug
    ? bugSchema.safeParse({ title: values.title, version: values.version, env: values.env, log: values.log, what: values.body, steps: values.steps })
    : (blog ? announcementSchema : threadSchema).safeParse(values);
  if (!parsed.success) {
    const bad = String(parsed.error.issues[0].path[0]);
    error = t(lang, bad === "title" ? "forum.err.title" : bad === "body" ? "forum.err.body" : `forum.err.${bad}`);
  } else if (!rateLimit(`thread:${user.id}`, 1, 60_000)) {
    error = t(lang, "forum.err.rate");
  } else {
    const d = parsed.data;
    const thread = await prisma.thread.create({
      data: {
        categoryId: category.id,
        authorId: user.id,
        title: d.title,
        ...("cover" in d && { subtitle: d.subtitle, cover: d.cover, image: d.image }),
        posts: { create: { authorId: user.id, body: "what" in d ? bugBody(d) : d.body } },
      },
    });
    return Astro.redirect(`/forum/t/${thread.id}`, 303);
  }
}
const name = t(lang, `cat.${category.slug}.name`);
const icons: Record<string, string> = { announcements: "campaign", guides: "menu_book", suggestions: "lightbulb", "bug-reports": "bug_report" };
---

<Layout title={t(lang, "forum.newThread.title", { category: name })} noindex>
  <div class="container-base max-w-6xl space-y-4">
    <nav class="text-sm text-muted flex gap-x-2">
      <a href="/forum" class="hover:text-foreground">{t(lang, "nav.forum")}</a><span>/</span>
      <a href={`/forum/c/${category.slug}`} class="hover:text-foreground">{name}</a>
    </nav>
    {denied ? (
      <p class="rounded-2xl border border-white/10 bg-surface p-5 text-muted">{t(lang, category.postRole === "admin" ? "forum.adminOnly" : "forum.staffOnly")}</p>
    ) : (
      <ThreadForm
        heading={t(lang, "forum.newThread.title", { category: name })}
        sub={t(lang, blog ? "compose.sub.news" : bug ? "compose.sub.bug" : category.kind === "suggestions" ? "compose.sub.suggestion" : "compose.sub.thread")}
        icon={icons[category.slug] ?? "chat"}
        blog={blog}
        bug={bug}
        values={values}
        error={error}
        submit={t(lang, "forum.create")}
        cancel={`/forum/c/${category.slug}`}
        previewAction={blog ? `/forum/c/${category.slug}/preview` : undefined}
      />
    )}
  </div>
</Layout>
