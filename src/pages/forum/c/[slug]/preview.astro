---
// Preview window for an announcement: the compose form posts its fields here (new window) and nothing is saved.
import Layout from "@/layouts/ForumLayout.astro";
import AnnouncementPost from "@/components/forum/AnnouncementPost.astro";
import { getLang, t } from "@/lib/forum/i18n/index.ts";
import { isAdmin, rateLimit, requireUser } from "@/lib/forum/guard.ts";
import { announcementSchema } from "@/lib/forum/schemas.ts";
import { renderMarkdown } from "@/lib/forum/text.ts";

const lang = getLang(Astro.request);
// Only the announcements form uses this, and only admins can write announcements.
if (Astro.params.slug !== "announcements") return Astro.rewrite("/404");
if (Astro.request.method !== "POST") return Astro.redirect("/forum/c/announcements/new");
const user = requireUser(Astro);
if (user instanceof Response) return user;
if (!isAdmin(user)) return new Response("Forbidden", { status: 403 });
if (!rateLimit(`preview:${user.id}`, 20, 60_000)) return new Response(t(lang, "forum.err.rate"), { status: 429 });

const form = await Astro.request.formData();
const pick = (k: string) => String(form.get(k) ?? "");
const parsed = announcementSchema.safeParse({
  title: pick("title") || "…",
  body: pick("body") || "…",
  subtitle: pick("subtitle"),
  cover: pick("cover"),
  image: pick("image"),
});
const date = new Date().toLocaleDateString(lang, { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" });
---

<Layout title={t(lang, "compose.preview.title")} noindex blog={parsed.success}>
  {parsed.success ? (
    <>
      <p class="fixed bottom-5 left-5 z-40 flex items-center gap-2 rounded-full border border-[#f97316]/50 bg-surface px-4 py-2 text-sm font-semibold text-[#f97316] shadow-dropdown">
        <span class="material-symbols-rounded text-lg">visibility</span>{t(lang, "compose.preview.note")}
      </p>
      <AnnouncementPost
        title={parsed.data.title}
        subtitle={parsed.data.subtitle}
        cover={parsed.data.cover}
        image={parsed.data.image}
        html={renderMarkdown(parsed.data.body)}
        date={date}
        author={user.username}
      />
    </>
  ) : (
    <div class="container-base max-w-3xl">
      <p class="rounded-2xl border border-error/40 bg-error-glass p-5 text-error">
        {(() => {
          const bad = String(parsed.error.issues[0].path[0]);
          return t(lang, bad === "title" ? "forum.err.title" : bad === "body" ? "forum.err.body" : `forum.err.${bad}`);
        })()}
      </p>
    </div>
  )}
</Layout>
