---
// Admins create colored community roles and give them to members (cosmetic, like Discord roles).
import Layout from "@/layouts/ForumLayout.astro";
import RoleChips from "@/components/forum/RoleChips.astro";
import { prisma } from "@/lib/prisma.ts";
import { getLang, t } from "@/lib/forum/i18n/index.ts";
import { isAdmin } from "@/lib/forum/guard.ts";

const lang = getLang(Astro.request);
const user = Astro.locals.user;
if (!user || user.banned || !isAdmin(user)) return Astro.rewrite("/404");

const flash = (kind: "err" | "msg") => {
  const v = Astro.url.searchParams.get(kind) ?? "";
  const key = `roles.${kind}.${v}`;
  return /^[a-z]{1,12}$/.test(v) && t(lang, key) !== key ? t(lang, key) : "";
};
const err = flash("err");
const msg = flash("msg");

const roles = await prisma.communityRole.findMany({
  orderBy: { id: "asc" },
  include: { users: { orderBy: { userId: "asc" }, include: { user: { select: { id: true, username: true } } } } },
});

const card = "rounded-2xl border border-white/10 bg-surface p-5";
const input = "rounded-xl border border-white/10 bg-background px-3 py-2 text-sm outline-none transition-colors focus:border-[#f97316]";
const btn = "rounded-xl border border-white/10 px-3 py-2 text-sm hover:bg-white/5 transition-colors";
const primary = "rounded-xl bg-[#f97316] px-4 py-2 text-sm font-semibold text-white hover:brightness-110 transition";
const colorInput = "h-10 w-14 cursor-pointer rounded-lg border border-white/10 bg-background p-1";
---

<Layout title={t(lang, "roles.title")} noindex>
  <div class="container-base max-w-4xl space-y-6">
    <nav class="text-sm text-muted flex gap-x-2">
      <a href="/forum/mod" class="hover:text-foreground">{t(lang, "mod.title")}</a><span>/</span><span>{t(lang, "roles.title")}</span>
    </nav>
    <header>
      <h1 class="text-2xl font-bold">{t(lang, "roles.title")}</h1>
      <p class="text-muted">{t(lang, "roles.sub")}</p>
    </header>
    {err && <p class="rounded-xl border border-error/40 bg-error-glass px-4 py-2 text-sm text-error" role="alert">{err}</p>}
    {msg && <p class="rounded-xl border border-white/10 bg-surface px-4 py-2 text-sm">{msg}</p>}

    <section class={`${card} space-y-3`}>
      <h2 class="font-bold">{t(lang, "roles.new")}</h2>
      <form method="post" action="/forum/mod/role-create" class="flex flex-wrap items-end gap-3">
        <input type="hidden" name="back" value="/forum/mod/roles" />
        <label class="text-sm text-muted">{t(lang, "roles.name")}
          <input name="name" required minlength="2" maxlength="32" class={`${input} mt-1 block w-56`} />
        </label>
        <label class="text-sm text-muted">{t(lang, "roles.color")}
          <input name="color" type="color" value="#f97316" class={`${colorInput} mt-1 block`} />
        </label>
        <button class={primary}>{t(lang, "roles.create")}</button>
      </form>
    </section>

    {roles.length > 0 && (
      <section class={`${card} space-y-3`}>
        <h2 class="font-bold">{t(lang, "roles.give")}</h2>
        <form method="post" action="/forum/mod/role-give" class="flex flex-wrap items-end gap-3">
          <input type="hidden" name="back" value="/forum/mod/roles" />
          <label class="text-sm text-muted">{t(lang, "roles.username")}
            <input name="username" required maxlength="80" class={`${input} mt-1 block w-56`} />
          </label>
          <label class="text-sm text-muted">{t(lang, "roles.pick")}
            <select name="roleId" class={`${input} mt-1 block`}>
              {roles.map((r) => <option value={r.id}>{r.name}</option>)}
            </select>
          </label>
          <button class={primary}>{t(lang, "roles.give.btn")}</button>
        </form>
      </section>
    )}

    <section class="space-y-4">
      {roles.map((r) => (
        <article class={`${card} space-y-4`}>
          <div class="flex flex-wrap items-center justify-between gap-3">
            <p class="text-sm"><RoleChips roles={[r]} /></p>
            <div class="flex flex-wrap items-center gap-2">
              <form method="post" action="/forum/mod/role-update" class="flex flex-wrap items-center gap-2">
                <input type="hidden" name="back" value="/forum/mod/roles" />
                <input type="hidden" name="roleId" value={r.id} />
                <input name="name" required minlength="2" maxlength="32" value={r.name} aria-label={t(lang, "roles.name")} class={`${input} w-44`} />
                <input name="color" type="color" value={r.color} aria-label={t(lang, "roles.color")} class={colorInput} />
                <button class={btn}>{t(lang, "roles.save")}</button>
              </form>
              <form method="post" action="/forum/mod/role-delete" onsubmit={`return confirm(${JSON.stringify(t(lang, "roles.delete.confirm"))})`}>
                <input type="hidden" name="back" value="/forum/mod/roles" />
                <input type="hidden" name="roleId" value={r.id} />
                <button class={`${btn} text-error`}>{t(lang, "roles.delete")}</button>
              </form>
            </div>
          </div>
          <div>
            <h3 class="mb-2 text-sm font-semibold text-muted">{t(lang, "roles.members")} ({r.users.length})</h3>
            {r.users.length === 0 ? (
              <p class="text-sm text-muted">{t(lang, "roles.noMembers")}</p>
            ) : (
              <ul class="flex flex-wrap gap-2">
                {r.users.map((u) => (
                  <li class="flex items-center gap-1 rounded-full border border-white/10 bg-background py-1 pl-3 pr-1 text-sm">
                    <a href={`/forum/u/${u.user.id}`} class="hover:underline">{u.user.username}</a>
                    <form method="post" action="/forum/mod/role-remove">
                      <input type="hidden" name="back" value="/forum/mod/roles" />
                      <input type="hidden" name="roleId" value={r.id} />
                      <input type="hidden" name="userId" value={u.user.id} />
                      <button class="flex size-6 items-center justify-center rounded-full text-muted hover:bg-white/10 hover:text-foreground" title={t(lang, "roles.remove")} aria-label={t(lang, "roles.remove")}>
                        <span class="material-symbols-rounded text-base">close</span>
                      </button>
                    </form>
                  </li>
                ))}
              </ul>
            )}
          </div>
        </article>
      ))}
      {roles.length === 0 && <p class="text-muted">{t(lang, "roles.empty")}</p>}
    </section>
  </div>
</Layout>
