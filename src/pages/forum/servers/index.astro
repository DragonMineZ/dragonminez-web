---
import Layout from "@/layouts/ForumLayout.astro";
import Pagination from "@/components/forum/Pagination.astro";
import CopyAddress from "@/components/forum/CopyAddress.astro";
import { prisma } from "@/lib/prisma.ts";
import { getLang, t } from "@/lib/forum/i18n/index.ts";
import { excerpt } from "@/lib/forum/text.ts";

const PAGE_SIZE = 20;
const lang = getLang(Astro.request);
const user = Astro.locals.user;
const params = Astro.url.searchParams;

const q = (params.get("q") ?? "").trim().slice(0, 60);
const langs = ["en", "es", "pt", "other"];
const filterLang = langs.includes(params.get("lang") ?? "") ? (params.get("lang") as string) : "";

const where = {
  status: "approved",
  ...(q && { name: { contains: q, mode: "insensitive" as const } }),
  ...(filterLang && { language: filterLang }),
};
const total = await prisma.server.count({ where });
const pages = Math.max(1, Math.ceil(total / PAGE_SIZE));
const page = Math.min(Math.max(1, Number(params.get("page")) || 1), pages);
const servers = await prisma.server.findMany({
  where,
  orderBy: { createdAt: "desc" },
  skip: (page - 1) * PAGE_SIZE,
  take: PAGE_SIZE,
  include: { owner: { select: { id: true, username: true } }, thread: { select: { replyCount: true } } },
});
const mine = user
  ? await prisma.server.findMany({ where: { ownerId: user.id, status: { not: "approved" } }, orderBy: { createdAt: "desc" } })
  : [];
const addHref = user ? "/forum/servers/new" : `/forum/login?next=${encodeURIComponent("/forum/servers/new")}`;
const field = "rounded-xl border border-white/10 bg-background px-3 py-2 text-foreground";
---

<Layout title={t(lang, "servers.title")} description={t(lang, "servers.subtitle")}>
  <div class="container-base space-y-6">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div>
        <h1 class="text-2xl font-bold">{t(lang, "servers.title")}</h1>
        <p class="text-muted">{t(lang, "servers.subtitle")}</p>
      </div>
      <a href={addHref} class="rounded-xl bg-[#f97316] px-4 py-2 text-white font-semibold hover:brightness-110 transition">{t(lang, "servers.add")}</a>
    </div>

    {mine.length > 0 && (
      <section class="rounded-2xl border border-white/10 bg-surface p-5 space-y-2">
        <h2 class="font-bold">{t(lang, "servers.yours")}</h2>
        <ul class="divide-y divide-white/10">
          {mine.map((s) => (
            <li class="py-2">
              <a href={`/forum/servers/${s.id}`} class="font-medium hover:underline">{s.name}</a>
              <span class={`ml-2 rounded-md px-2 py-0.5 text-xs font-semibold ${s.status === "rejected" ? "bg-error-glass text-error" : "bg-[#f97316]/15 text-[#f97316]"}`}>
                {t(lang, `servers.status.${s.status}`)}
              </span>
              {s.status === "rejected" && s.rejectReason && (
                <p class="text-sm text-muted">{t(lang, "servers.rejectReason", { reason: s.rejectReason })}</p>
              )}
            </li>
          ))}
        </ul>
      </section>
    )}

    <form method="get" class="flex flex-wrap items-end gap-3 rounded-2xl border border-white/10 bg-surface p-4">
      <label class="text-sm text-muted">
        {t(lang, "servers.filter.q")}
        <input name="q" value={q} maxlength="60" class={`${field} mt-1 block`} />
      </label>
      <label class="text-sm text-muted">
        {t(lang, "servers.filter.lang")}
        <select name="lang" class={`${field} mt-1 block`}>
          <option value="">{t(lang, "servers.filter.all")}</option>
          {langs.map((l) => <option value={l} selected={l === filterLang}>{t(lang, `servers.lang.${l}`)}</option>)}
        </select>
      </label>
      <button class="rounded-xl bg-[#f97316] px-4 py-2 text-white font-semibold hover:brightness-110 transition">{t(lang, "servers.filter.apply")}</button>
      {(q || filterLang) && <a href="/forum/servers" class="py-2 text-sm text-muted hover:text-foreground">{t(lang, "servers.filter.clear")}</a>}
    </form>

    {servers.length === 0 ? (
      <p class="rounded-2xl border border-white/10 bg-surface p-5 text-muted">{t(lang, "servers.empty")}</p>
    ) : (
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {servers.map((s) => (
          <article class="flex flex-col gap-3 rounded-2xl border border-white/10 bg-surface p-5">
            <div class="flex items-start justify-between gap-2">
              <h2 class="font-bold text-lg min-w-0 break-words"><a href={`/forum/servers/${s.id}`} class="hover:underline">{s.name}</a></h2>
              <span class="shrink-0 rounded-md bg-white/10 px-2 py-0.5 text-xs font-semibold text-muted">{s.languageOther ?? t(lang, `servers.lang.${s.language}`)}</span>
            </div>
            <p class="text-sm text-muted flex-1">{excerpt(s.description, 140)}</p>
            <CopyAddress address={s.address} />
            <p class="text-xs text-muted">
              {t(lang, "forum.by")}
              <a href={`/forum/u/${s.owner.id}`} class="hover:text-foreground">{s.owner.username}</a> ·
              {t(lang, s.thread.replyCount === 1 ? "forum.reply1" : "forum.replies", { count: s.thread.replyCount })}
            </p>
          </article>
        ))}
      </div>
    )}
    <Pagination page={page} pages={pages} />
  </div>
</Layout>
