---
import Layout from "@/layouts/ForumLayout.astro";
import MarkdownField from "@/components/forum/MarkdownField.astro";
import { prisma } from "@/lib/prisma.ts";
import { getLang, t } from "@/lib/forum/i18n/index.ts";
import { rateLimit, requireUser } from "@/lib/forum/guard.ts";
import { ADDRESS_PATTERN, serverSchema } from "@/lib/forum/schemas.ts";

const lang = getLang(Astro.request);
const user = requireUser(Astro);
if (user instanceof Response) return user;

let error = "";
let values = { name: "", address: "", language: lang, languageOther: "", description: "", discordInvite: "" };
if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const str = (k: string) => String(form.get(k) ?? "");
  values = { name: str("name"), address: str("address"), language: str("language"), languageOther: str("languageOther"), description: str("description"), discordInvite: str("discordInvite") };
  const parsed = serverSchema.safeParse(values);
  if (!parsed.success) {
    error = t(lang, `servers.err.${parsed.error.issues[0].path[0]}`);
  } else {
    const owned = await prisma.server.count({ where: { ownerId: user.id, status: { not: "rejected" } } });
    const category = await prisma.forumCategory.findFirst({ where: { kind: "servers" } });
    if (owned >= 3) error = t(lang, "servers.err.limit");
    else if (!category) return new Response("Not found", { status: 404 });
    else if (!rateLimit(`server:${user.id}`, 3, 24 * 60 * 60_000)) error = t(lang, "servers.err.rate");
    else {
      const d = parsed.data;
      const thread = await prisma.thread.create({
        data: {
          categoryId: category.id,
          authorId: user.id,
          title: d.name,
          posts: { create: { authorId: user.id, body: d.description } },
          server: {
            create: { ownerId: user.id, name: d.name, address: d.address, language: d.language, languageOther: d.languageOther, description: d.description, discordInvite: d.discordInvite },
          },
        },
        include: { server: true },
      });
      return Astro.redirect(`/forum/servers/${thread.server!.id}`, 303);
    }
  }
}
const field = "mt-1 w-full rounded-xl border border-white/10 bg-background px-3 py-2 text-foreground";
// Suggestions for "Other": language names in the reader's language, from the runtime (no list to maintain).
const names = new Intl.DisplayNames([lang], { type: "language" });
const suggestions = ["fr", "de", "it", "nl", "pl", "ru", "uk", "tr", "ar", "he", "hi", "id", "ms", "th", "vi", "zh", "ja", "ko", "tl", "sv", "no", "da", "fi", "cs", "ro", "hu", "el", "ca", "gl", "eu"]
  .map((c) => names.of(c) ?? c)
  .sort((a, b) => a.localeCompare(b, lang));
---

<Layout title={t(lang, "servers.new.title")} noindex>
  <div class="container-base max-w-3xl space-y-4">
    <nav class="text-sm text-muted flex gap-x-2">
      <a href="/forum/servers" class="hover:text-foreground">{t(lang, "servers.title")}</a>
    </nav>
    <h1 class="text-2xl font-bold">{t(lang, "servers.new.title")}</h1>
    <p class="text-muted">{t(lang, "servers.new.note")}</p>
    <form method="post" class="rounded-2xl border border-white/10 bg-surface p-5 space-y-4">
      {error && <p class="rounded-xl border border-error/40 bg-error-glass px-4 py-2 text-sm text-error" role="alert">{error}</p>}
      <label class="block text-sm text-muted">
        {t(lang, "servers.field.name")} <span class="text-[#f97316]" aria-hidden="true">*</span>
        <input name="name" required minlength="3" maxlength="60" value={values.name} class={field} />
      </label>
      <label class="block text-sm text-muted">
        {t(lang, "servers.field.address")} <span class="text-[#f97316]" aria-hidden="true">*</span>
        <input name="address" required maxlength="120" pattern={ADDRESS_PATTERN} title={t(lang, "servers.err.address")} value={values.address} placeholder="play.example.com:25565" class={`${field} font-mono`} />
      </label>
      <!-- "Other" shows the language name field (CSS :has, no JS). -->
      <div class="group grid gap-4 sm:grid-cols-2">
        <label class="block text-sm text-muted">
          {t(lang, "servers.field.language")} <span class="text-[#f97316]" aria-hidden="true">*</span>
          <select name="language" required class={field}>
            {["en", "es", "pt", "other"].map((l) => <option value={l} selected={l === values.language}>{t(lang, `servers.lang.${l}`)}</option>)}
          </select>
        </label>
        <label class="hidden text-sm text-muted group-has-[option[value=other]:checked]:block">
          {t(lang, "servers.field.languageOther")} <span class="text-[#f97316]" aria-hidden="true">*</span>
          <input name="languageOther" list="language-names" maxlength="40" value={values.languageOther} placeholder={suggestions[0]} autocomplete="off" class={field} />
          <datalist id="language-names">{suggestions.map((n) => <option value={n} />)}</datalist>
        </label>
      </div>
      <label class="block text-sm text-muted">
        {t(lang, "servers.field.invite")}
        <input name="discordInvite" maxlength="100" value={values.discordInvite} placeholder="https://discord.gg/..." class={field} />
      </label>
      <MarkdownField name="description" label={t(lang, "servers.field.description")} value={values.description} rows={8} />
      <button class="rounded-xl bg-[#f97316] px-4 py-2 text-white font-semibold hover:brightness-110 transition">{t(lang, "servers.submit")}</button>
    </form>
  </div>
</Layout>
