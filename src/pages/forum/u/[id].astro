---
import Layout from "@/layouts/ForumLayout.astro";
import { prisma } from "@/lib/prisma.ts";
import { getLang, t, timeAgo } from "@/lib/forum/i18n/index.ts";
import { isStaff } from "@/lib/forum/guard.ts";
import RoleChips from "@/components/forum/RoleChips.astro";
import { chips, nameColor } from "@/lib/forum/communityRoles.ts";

const lang = getLang(Astro.request);
const viewer = Astro.locals.user;
const id = /^\d{1,9}$/.test(Astro.params.id ?? "") ? Number(Astro.params.id) : 0;
const profile = id ? await prisma.forumUser.findUnique({ where: { id }, include: { roles: { select: { role: { select: { id: true, name: true, color: true } } } } } }) : null;
if (!profile) return Astro.rewrite("/404");

const staff = isStaff(viewer) && !viewer?.banned;
// Threads of servers that are not approved are for staff and the owner only (see canSeeThread).
const seesAll = staff || viewer?.id === profile.id;
const [posts, likes, threads, servers] = await Promise.all([
  prisma.post.count({ where: { authorId: id, deletedAt: null } }),
  prisma.forumLike.count({ where: { post: { authorId: id, deletedAt: null } } }),
  prisma.thread.findMany({
    where: { authorId: id, ...(!seesAll && { OR: [{ server: { is: null } }, { server: { is: { status: "approved" } } }] }) },
    orderBy: { createdAt: "desc" },
    take: 10,
    include: { category: { select: { slug: true } } },
  }),
  prisma.server.findMany({ where: { ownerId: id, status: "approved" }, orderBy: { createdAt: "desc" }, take: 20 }),
]);
const canBan = staff && profile.role !== "admin" && profile.id !== viewer?.id;
const badge = "rounded-md bg-[#f97316]/15 px-2 py-0.5 text-xs font-semibold text-[#f97316]";
const card = "rounded-2xl border border-white/10 bg-surface divide-y divide-white/10 overflow-hidden";
---

<Layout title={profile.username} noindex>
  <div class="container-base max-w-4xl space-y-6">
    <section class="flex flex-wrap items-center gap-5 rounded-2xl border border-white/10 bg-surface p-5">
      {profile.avatarUrl ? (
        <img src={profile.avatarUrl} alt="" width="72" height="72" class="size-18 rounded-full" referrerpolicy="no-referrer" />
      ) : (
        <span class="flex size-18 items-center justify-center rounded-full bg-[#f97316] text-3xl font-bold text-white">
          {profile.username.charAt(0).toUpperCase()}
        </span>
      )}
      <div class="min-w-0 flex-1 space-y-1">
        <div class="flex flex-wrap items-center gap-2">
          <h1 class="text-2xl font-bold break-words min-w-0" style={nameColor(chips(profile.roles)) ? `color: ${nameColor(chips(profile.roles))}` : undefined}>{profile.username}</h1>
          {profile.role !== "member" && <span class={badge}>{t(lang, `role.${profile.role}`)}</span>}
          <RoleChips roles={chips(profile.roles)} />
          {staff && profile.bannedAt && <span class="rounded-md bg-error-glass px-2 py-0.5 text-xs font-semibold text-error">{t(lang, "profile.banned")}</span>}
        </div>
        <p class="text-sm text-muted">
          {t(lang, "profile.joined", { date: profile.createdAt.toLocaleDateString(lang, { dateStyle: "medium" }) })} ·
          {t(lang, "profile.posts", { count: posts })} · {t(lang, "profile.likes", { count: likes })}
        </p>
      </div>
      {canBan && (
        <a href={`/forum/mod?user=${profile.id}`} class="rounded-xl border border-white/10 px-3 py-1.5 text-sm text-error hover:bg-white/5 transition-colors">{t(lang, "profile.ban")}</a>
      )}
    </section>

    <section class="space-y-3">
      <h2 class="text-lg font-bold">{t(lang, "profile.threads")}</h2>
      <ul class={card}>
        {threads.map((th) => (
          <li class="flex items-center justify-between gap-4 px-5 py-3 hover:bg-white/5 transition-colors">
            <a href={`/forum/t/${th.id}`} class="font-medium truncate">{th.title}</a>
            <span class="shrink-0 text-sm text-muted">{t(lang, `cat.${th.category.slug}.name`)} · {timeAgo(lang, th.createdAt)}</span>
          </li>
        ))}
        {threads.length === 0 && <li class="px-5 py-4 text-muted">{t(lang, "profile.noThreads")}</li>}
      </ul>
    </section>

    <section class="space-y-3">
      <h2 class="text-lg font-bold">{t(lang, "profile.servers")}</h2>
      <ul class={card}>
        {servers.map((s) => (
          <li class="flex items-center justify-between gap-4 px-5 py-3 hover:bg-white/5 transition-colors">
            <a href={`/forum/servers/${s.id}`} class="font-medium truncate">{s.name}</a>
            <span class="shrink-0 text-sm text-muted">{s.languageOther ?? t(lang, `servers.lang.${s.language}`)}</span>
          </li>
        ))}
        {servers.length === 0 && <li class="px-5 py-4 text-muted">{t(lang, "profile.noServers")}</li>}
      </ul>
    </section>
  </div>
</Layout>
