---
import Layout from "../layouts/Layout.astro";
import HairEditorPage from "../components/features/editor/HairEditorPage";

const code = Astro.url.searchParams.get('code') || '';
const id = Astro.url.searchParams.get('id') || '';
const name = Astro.url.searchParams.get('name') || '';
---

<Layout title="Hair Editor | DragonMineZ" i18nTitle="editor.title" noindex={true}>

  <section class="min-h-screen pt-20 pb-6">
    <HairEditorPage client:only="react" code={code} hairId={id} name={name} />
  </section>
</Layout>
